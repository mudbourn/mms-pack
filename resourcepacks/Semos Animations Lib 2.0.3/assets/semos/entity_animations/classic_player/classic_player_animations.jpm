{
	"credit": "By Seb_Semos",
	"animations": [
				{
					"left_arm.visible": "!is_first_person_hand",
					"right_arm.visible": "!is_first_person_hand"
				},
				{
					"left_arm.rx": "if(limb_speed>0.1,sin(limb_swing*0.75)*limb_speed*1.5,torad(0))",
					"left_arm.ry": "if(limb_speed>0.1,torad(10),torad(0))",
					"left_arm.rz": "if(limb_speed>0.1,torad(-75),torad(0))",
					"right_arm.rx": "-left_arm.rx",
					"right_arm.ry": "-left_arm.ry",
					"right_arm.rz": "-left_arm.rz"
				},
				{
					"left_leg.rx": "if(limb_speed>0.1,-(sin(limb_swing*0.75)*limb_speed*1.6),torad(0))",
					"right_leg.rx": "-left_leg.rx"
				}
	]
}