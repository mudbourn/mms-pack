{
	"credit":"By Seb_Semos",
	"animations":[
		{			
			//Idle variables
			//Aiming
			"var.right_arm_idle_aim_rx":"torad(head_pitch+270-sin(age/100)*1)",
			"var.right_arm_idle_aim_ry":"right_arm.ry",
			"var.right_arm_idle_aim_rz":"sin(age/8)/10",			
			"var.left_arm_idle_aim_rx":"torad(head_pitch+270-sin(age/100)*1",
            "var.left_arm_idle_aim_ry":"left_arm.ry",
            "var.left_arm_idle_aim_rz":"sin(age/8)/10",			
			//Swiming
			"var.right_arm_idle_swim_rx":"torad(-50)-cos(var.swim)/4*clamp(1-limb_speed*8,0,1)+(cos(var.swim+sin(var.swim))+torad(30))*clamp(limb_speed*8,0,1)",
            "var.right_arm_idle_swim_ry":"torad(30)-sin(var.swim+cos(var.swim)/4)*clamp(1-limb_speed*8,0,1)+(torad(5)+cos(pi/8+var.swim+sin(var.swim)/2)/2+clamp(-sin(var.swim),-pi/2,0))*clamp(limb_speed*8,0,1)",
            "var.right_arm_idle_swim_rz":"-cos(var.swim)/2+(torad(20)+cos(var.swim)/2)*clamp(limb_speed*8,0,1)",            
            "var.left_arm_idle_swim_rx":"torad(-50)-cos(var.swim)/4*clamp(1-limb_speed*8,0,1)+(cos(var.swim+sin(var.swim))+torad(30))*clamp(limb_speed*8,0,1)",
            "var.left_arm_idle_swim_ry":"torad(-30)+sin(var.swim+cos(var.swim)/4)*clamp(1-limb_speed*8,0,1)+(torad(-5)-cos(pi/8+var.swim+sin(var.swim)/2)/2+clamp(sin(var.swim),0,pi/2))*clamp(limb_speed*8,0,1)",
            "var.left_arm_idle_swim_rz":"cos(var.swim)/2+(torad(-20)-cos(var.swim)/2)*clamp(limb_speed*8,0,1)",			
			//Idle state
			"var.right_arm_rx":"((-sin(var.ls)*limb_speed)+torad(head_yaw)/8)+torad(5)*var.pose+(-sin(-pi/3+var.r+var.b+sin(var.r+var.b))/6)+(sin(limb_swing/2)-pi/4)/2*if(is_hurt,-sin(hurt_time*pi/5)/6*hurt_time,0)",
			"var.right_arm_ry":"(-torad(15)*clamp(limb_speed*4,0,1)+cos(var.r+var.b)/30)-torad(20)*var.pose",
			"var.right_arm_rz":"-torad(head_pitch)/14+torad(8+0.5*var.pose)",		
			"var.left_arm_rx":"((sin(var.ls)*limb_speed)-torad(head_yaw)/8)+torad(5)*var.pose+(-sin(-pi/3+var.r+var.b+sin(var.r+var.b))/6)+(sin(limb_swing/2)-pi/4)/2*if(is_hurt,-sin(hurt_time*pi/5)/6*hurt_time,0)",
			"var.left_arm_ry":"(+torad(15)*clamp(limb_speed*4,0,1)-cos(var.r+var.b)/30)+torad(20)*var.pose",
			"var.left_arm_rz":"+torad(head_pitch)/14+torad(-8+0.5*var.pose)",
			//Door opening
			"var.right_arm_idle_door_rx":"torad(-90+swing_progress)",
            "var.left_arm_idle_door_rx":"torad(-90+swing_progress)",

			//Right
			"var.right_arm_idle_rx":"if(varb.aim,var.right_arm_idle_aim_rx,varb.in_water,var.right_arm_idle_swim_rx,varb.open_door_right_hand,var.right_arm_idle_door_rx,is_riding,torad(-45),var.right_arm_rx)",
			"var.right_arm_idle_ry":"if(varb.aim,var.right_arm_idle_aim_ry,varb.in_water,var.right_arm_idle_swim_ry,is_riding,torad(20),var.right_arm_ry)",
			"var.right_arm_idle_rz":"if(varb.aim,var.right_arm_idle_aim_rz,varb.in_water,var.right_arm_idle_swim_rz,var.right_arm_rz)",
			//Left
			"var.left_arm_idle_rx":"if(varb.aim,var.left_arm_idle_aim_rx,varb.in_water,var.left_arm_idle_swim_rx,varb.open_door_left_hand,var.left_arm_idle_door_rx,is_riding,torad(-45),var.left_arm_rx)",
			"var.left_arm_idle_ry":"if(varb.aim,var.left_arm_idle_aim_ry,varb.in_water,var.left_arm_idle_swim_ry,is_riding,torad(-20),var.left_arm_ry)",
			"var.left_arm_idle_rz":"if(varb.aim,var.left_arm_idle_aim_rz,varb.in_water,var.left_arm_idle_swim_rz,var.left_arm_rz)",
			
			//No weapon in hand/tool
			//Right
			"var.empty_arm_right_arm_rx":"if(varb.no_weapons,if(varb.agressive,torad(300-sin(age/1)*5),if(varb.attack,clamp((torad(100)+(todeg(-swing_progress/10))),-2,-1),var.right_arm_idle_rx)),if(varb.aim,torad(head_pitch+270-sin(age/100)*1),var.right_arm_idle_rx))",
			"var.empty_arm_right_arm_ry":"if(varb.no_weapons,if(varb.agressive,torad(25+sin(age)*10),if(varb.attack,torad(20),var.right_arm_idle_ry)),if(varb.aim,right_arm.ry,var.right_arm_idle_ry))",
			"var.empty_arm_right_arm_rz":"if(varb.no_weapons,if(varb.agressive,torad(45+age*50),if(varb.attack,torad(-30),var.right_arm_idle_rz)),if(varb.aim,torad(0),var.right_arm_idle_rz))",
			"var.empty_arm_right_arm_tx":"if(varb.no_weapons,if(varb.agressive,-5,if(varb.attack,-5,var.right_arm_idle_tx-5)),-5)",
			"var.empty_arm_right_arm_ty":"if(varb.no_weapons,if(varb.agressive,+2,if(varb.attack,+2,var.right_arm_idle_ty)),2)",
			"var.empty_arm_right_arm_tz":"if(varb.no_weapons,if(varb.agressive,0,if(varb.attack,0,var.right_arm_idle_tz)),0)",
			//Left
			"var.empty_arm_left_arm_rx":"if(varb.no_weapons,if(varb.agressive,torad(300-sin(age/1)*5),if(varb.attack,clamp((torad(100)+(todeg(-swing_progress/10))),-2,-1),var.left_arm_idle_rx)),if(varb.aim,torad(head_pitch+270-sin(age/100)*1),var.left_arm_idle_rx))",
			"var.empty_arm_left_arm_ry":"if(varb.no_weapons,if(varb.agressive,torad(-25+sin(age)*10),if(varb.attack,torad(-20),var.left_arm_idle_ry)),if(varb.aim,left_arm.ry,var.left_arm_idle_ry))",
			"var.empty_arm_left_arm_rz":"if(varb.no_weapons,if(varb.agressive,torad(-45+age*50),if(varb.attack,torad(-30),var.left_arm_idle_rz)),if(varb.aim,torad(0),var.left_arm_idle_rz))",
			"var.empty_arm_left_arm_tx":"if(varb.no_weapons,if(varb.agressive,5,if(varb.attack,5,var.left_arm_idle_tx+5)),5)",
			"var.empty_arm_left_arm_ty":"if(varb.no_weapons,if(varb.agressive,+2,if(varb.attack,+2,var.left_arm_idle_ty)),2)",
			"var.empty_arm_left_arm_tz":"if(varb.no_weapons,if(varb.agressive,0,if(varb.attack,0,var.left_arm_idle_tz)),0)",

			//Other items than weapons/tools are considered food			
			//Right	
			"var.food_right_arm_rx":"if(varb.eat_left_handed,torad(-60)+sin(age/5)/5,torad(-90))",
			"var.food_right_arm_ry":"if(varb.eat_left_handed,torad(-45),torad(0))",
			"var.food_right_arm_rz":"if(varb.eat_left_handed,torad(-25)+sin(age/2)/10,torad(-13))",
			"var.food_right_arm_tx":"if(varb.eat_left_handed,-5,-2)",
			"var.food_right_arm_ty":"if(varb.eat_left_handed,2,11.5)",
			"var.food_right_arm_tz":"if(varb.eat_left_handed,0,if(varb.chestplate,2,3))",
			//Left
			"var.food_left_arm_rx":"if(varb.eat_right_handed,torad(-90)+sin(age/5)/5,torad(-90))",
			"var.food_left_arm_ry":"if(varb.eat_right_handed,torad(45),torad(0))",
			"var.food_left_arm_rz":"if(varb.eat_right_handed,torad(-25)+sin(age/2)/10,torad(13))",
			"var.food_left_arm_tx":"if(varb.eat_right_handed,5,2)",
			"var.food_left_arm_ty":"if(varb.eat_right_handed,2,11.5)",
			"var.food_left_arm_tz":"if(varb.eat_right_handed,0,if(varb.chestplate,2,3))",
			
			//Shields
			//Right
			"var.shield_right_arm_rx":"if(varb.agressive,if(varb.aim,torad(head_pitch+270-sin(age/100)*1),torad(-30)+sin(age/6)/10),if(varb.attack,torad(-30)+sin(age/6)/10,torad(40)))",
			"var.shield_right_arm_ry":"if(varb.agressive,if(varb.aim,right_arm.ry,torad(325)+sin(swing_progress*pi)*1.5),if(varb.attack,torad(325)+sin(swing_progress*pi)*1.5,torad(90)))",
			"var.shield_right_arm_rz":"if(varb.agressive,sin(age/8)/10,if(varb.attack,sin(age/8)/10,torad(0)))",
			"var.shield_right_arm_tx":"if(varb.agressive,-5,if(varb.attack,-6.5,-3.5))",
			"var.shield_right_arm_ty":"if(varb.agressive,+2,if(varb.attack,+2,+2))",
			"var.shield_right_arm_tz":"if(varb.agressive,0,if(varb.attack,0,0.5))",
			//Left
			"var.shield_left_arm_rx":"if(varb.agressive,if(varb.aim,torad(head_pitch+270-sin(age/100)*1),torad(-30)+sin(age/6)/10),if(varb.attack,torad(-30)+sin(age/6)/10,torad(40)))",
			"var.shield_left_arm_ry":"if(varb.agressive,if(varb.aim,left_arm.ry,torad(45)-sin(swing_progress*pi)*1.5),if(varb.attack,torad(45)-sin(swing_progress*pi)*1.5,torad(-90)))",
			"var.shield_left_arm_rz":"if(varb.agressive,sin(age/8)/10,if(varb.attack,sin(age/8)/10,torad(0)))",
			"var.shield_left_arm_tx":"if(varb.agressive,5,if(varb.attack,6.5,3.5))",
			"var.shield_left_arm_ty":"if(varb.agressive,+2,if(varb.attack,+2,+2))",
			"var.shield_left_arm_tz":"if(varb.agressive,0,if(varb.attack,0,0.5))"
		},
		{
			//Swords
			//Right
			"var.sword_right_arm_rx":"if(varb.attack,clamp(torad(250)-(todeg(-swing_progress/10)),torad(250),torad(420)),varb.agressive,torad(-300-sin(age/10)*5),torad(35))",
			"var.sword_right_arm_ry":"if(varb.attack,-sin(swing_progress*pi),varb.agressive,torad(sin(age/10)*5),torad(180))",
			"var.sword_right_arm_rz":"if(varb.attack,torad(0),varb.agressive,torad(45),torad(0))",
			"var.sword_right_arm_tx":"if(varb.attack,-5,varb.agressive,-5,if(varb.chestplate,4.5,3.8))",			
			"var.sword_right_arm_ty":"if(varb.attack,2,varb.agressive,2,2)",
			"var.sword_right_arm_tz":"if(varb.attack,0,varb.agressive,0,0)",
			//Left
			"var.sword_left_arm_rx":"if(varb.attack,clamp(torad(250)-(todeg(-swing_progress/10)),torad(250),torad(420)),varb.agressive,torad(-300-sin(age/10)*5),torad(35))",
			"var.sword_left_arm_ry":"if(varb.attack,torad(-10),varb.agressive,torad(sin(age/10)*5),torad(180))",
			"var.sword_left_arm_rz":"if(varb.attack,torad(-45),varb.agressive,torad(-45),torad(0))",
			"var.sword_left_arm_tx":"if(varb.attack,5.75,varb.agressive,5,if(varb.chestplate,-4.5,-3.8))",
			"var.sword_left_arm_ty":"if(varb.attack,2,varb.agressive,2,2)",
			"var.sword_left_arm_tz":"if(varb.attack,0,varb.agressive,0,0)",
			//Axes
			//Right ok
			"var.axe_right_arm_rx": "if(varb.attack,clamp(torad(150)-(todeg(-swing_progress/10)),0,6),varb.agressive,torad(sin(age/10)*5),torad(-35))",
			"var.axe_right_arm_ry": "if(varb.attack,torad(45)-sin(swing_progress*pi)*1.5,varb.agressive,torad(sin(age/10)*5),torad(0))",
			"var.axe_right_arm_rz": "if(varb.attack,sin(age/8)/10,varb.agressive,torad(30),torad(0))",
			"var.axe_right_arm_tx": "if(varb.attack,-6.5,varb.agressive,-5.75,if(varb.chestplate,6.8,6))",
			"var.axe_right_arm_ty": "if(varb.attack,2,varb.agressive,2,7)",
			"var.axe_right_arm_tz": "if(varb.attack,-0.25,varb.agressive,-0.25,9.5)",
			//Left ok
			"var.axe_left_arm_rx": "if(varb.attack,clamp(torad(150)-(todeg(-swing_progress/10)),0,6),varb.agressive,torad(sin(age/10)*5),torad(-35))",
			"var.axe_left_arm_ry": "if(varb.attack,torad(-45)+sin(swing_progress*pi)*1.5,varb.agressive,torad(sin(age/10)*5),torad(0))",
			"var.axe_left_arm_rz": "if(varb.attack,sin(age/8)/10,varb.agressive,torad(-30),torad(0))",
			"var.axe_left_arm_tx": "if(varb.attack,6.5,varb.agressive,5.75,if(varb.chestplate,-6.8,-6))",
			"var.axe_left_arm_ty": "if(varb.attack,2,varb.agressive,2,7)",
			"var.axe_left_arm_tz": "if(varb.attack,-0.25,varb.agressive,-0.25,9.5)"
		},
		{
			//Crossbow (Range units uses the axe attack if they don't actually fire in close combat)
			//Right
			"var.crossbow_right_arm_rx": "if(varb.attack,var.axe_right_arm_rx,varb.agressive,torad(head_pitch+280-sin(age/100)*1),torad(-90)",
			"var.crossbow_right_arm_ry": "if(varb.attack,var.axe_right_arm_ry,varb.agressive,torad(head_yaw-15+sin(age/100)*1),torad(215)",
			"var.crossbow_right_arm_rz": "if(varb.attack,var.axe_right_arm_rz,varb.agressive,torad(0),torad(90)",
			"var.crossbow_right_arm_tx": "if(varb.attack,var.axe_right_arm_tx,varb.agressive,-5.75,if(varb.chestplate,3.5,2.75)",
			"var.crossbow_right_arm_ty": "if(varb.attack,var.axe_right_arm_ty,varb.agressive,2,2",
			"var.crossbow_right_arm_tz": "if(varb.attack,var.axe_right_arm_tz,varb.agressive,0.5,-8",
			//Left
			"var.crossbow_left_arm_rx": "if(varb.attack,var.axe_left_arm_rx,varb.agressive,torad(head_pitch+280-sin(age/100)*1),torad(90)",
			"var.crossbow_left_arm_ry": "if(varb.attack,var.axe_left_arm_ry,varb.agressive,torad(head_yaw+15+sin(age/100)*1),torad(35)",
			"var.crossbow_left_arm_rz": "if(varb.attack,var.axe_left_arm_rz,varb.agressive,torad(0),torad(90)",
			"var.crossbow_left_arm_tx": "if(varb.attack,var.axe_left_arm_tx,varb.agressive,5,if(varb.chestplate,-3.5,-2.75)",
			"var.crossbow_left_arm_ty": "if(varb.attack,var.axe_left_arm_ty,varb.agressive,2,2",
			"var.crossbow_left_arm_tz": "if(varb.attack,var.axe_left_arm_tz,varb.agressive,0,-8",
			//Bow (Range units uses the axe attack if they don't actually fire in close combat)
			//Right			
			"var.bow_right_arm_rx": "if(varb.attack,var.axe_right_arm_rx,varb.agressive,torad(head_pitch+280-sin(age/100)*1),torad(0)",
			"var.bow_right_arm_ry": "if(varb.attack,var.axe_right_arm_ry,varb.agressive,torad(head_yaw-15+sin(age/100)*1),torad(100)",
			"var.bow_right_arm_rz": "if(varb.attack,var.axe_right_arm_rz,varb.agressive,torad(0),torad(135)",
			"var.bow_right_arm_tx": "if(varb.attack,var.axe_right_arm_tx,varb.agressive,-5,5",
			"var.bow_right_arm_ty": "if(varb.attack,var.axe_right_arm_ty,varb.agressive,2,10",
			"var.bow_right_arm_tz": "if(varb.attack,var.axe_right_arm_tz,varb.agressive,0,if(varb.chestplate,3.5,3)",
			//Left
			"var.bow_left_arm_rx": "if(varb.attack,var.axe_left_arm_rx,varb.agressive,torad(head_pitch+280-sin(age/100)*1),torad(0)",
			"var.bow_left_arm_ry": "if(varb.attack,var.axe_left_arm_ry,varb.agressive,torad(head_yaw+15+sin(age/100)*1),torad(80)",
			"var.bow_left_arm_rz": "if(varb.attack,var.axe_left_arm_rz,varb.agressive,torad(0),torad(-135)",
			"var.bow_left_arm_tx": "if(varb.attack,var.axe_left_arm_tx,varb.agressive,5,-5",
			"var.bow_left_arm_ty": "if(varb.attack,var.axe_left_arm_ty,varb.agressive,2,10",
			"var.bow_left_arm_tz": "if(varb.attack,var.axe_left_arm_tz,varb.agressive,0,if(varb.chestplate,3.5,3)"
		},
		{
			//Evoker attack style
			"var.magic_right_arm_rx":"right_arm.rx",
			"var.magic_right_arm_ry":"right_arm.ry",
			"var.magic_right_arm_rz":"right_arm.rz",
			
			"var.magic_left_arm_rx":"left_arm.rx",
			"var.magic_left_arm_ry":"left_arm.ry",
			"var.magic_left_arm_rz":"left_arm.rz"			
		}
	]
}