{
	"credit": "Created by Semos for Freshly Modded",
	"animations": [
		{
			//Ardonis Staff
			//Right
			"var.ardonis_staff_right_arm_rx": "if(varb.attack,sin(swing_progress*pi)*5,varb.agressive,torad(sin(age/2)*35),torad(-45))",
			"var.ardonis_staff_right_arm_ry": "if(varb.attack,sin(swing_progress*pi)*10,varb.agressive,rot_y+age*0.8,torad(-90))",
			"var.ardonis_staff_right_arm_rz": "if(varb.attack,torad(45),varb.agressive,torad(45),torad(0))",
			"var.ardonis_staff_right_arm_tx": "if(varb.attack,-5,varb.agressive,-5,-8.5)",
			"var.ardonis_staff_right_arm_ty": "if(varb.attack,2,varb.agressive,2,2)",
			"var.ardonis_staff_right_arm_tz": "if(varb.attack,0,varb.agressive,0,if(varb.chestplate,4.25,4))",
			//Left
			"var.ardonis_staff_left_arm_rx": "if(varb.attack,sin(swing_progress*pi)*5,varb.agressive,torad(sin(age/2)*35),torad(-45))",
			"var.ardonis_staff_left_arm_ry": "if(varb.attack,sin(swing_progress*pi)*10,varb.agressive,rot_y+age*0.8,torad(90))",
			"var.ardonis_staff_left_arm_rz": "if(varb.attack,torad(-45),varb.agressive,torad(-45),torad(0))",
			"var.ardonis_staff_left_arm_tx": "if(varb.attack,5,varb.agressive,5,8.5)",
			"var.ardonis_staff_left_arm_ty": "if(varb.attack,2,varb.agressive,2,2)",
			"var.ardonis_staff_left_arm_tz": "if(varb.attack,0,varb.agressive,0,if(varb.chestplate,4.25,4))",
			//Special Swords
			//Right
			"var.special_sword_right_arm_rx": "if(varb.attack,clamp(-(torad(100)+(todeg(-swing_progress/10))),-3,1),varb.agressive,torad(30)+sin(age/6)/10,torad(0))",
			"var.special_sword_right_arm_ry": "if(varb.attack,torad(0)+sin(age/8)/10,varb.agressive,torad(55),torad(90))",
			"var.special_sword_right_arm_rz": "if(varb.attack,torad(115)+sin(age/8)/10,varb.agressive,torad(55)+sin(age/8)/10,torad(-35))",
			"var.special_sword_right_arm_tx": "if(varb.attack,-5,varb.agressive,-5,2)",
			"var.special_sword_right_arm_ty": "if(varb.attack,2,varb.agressive,2,-8)",
			"var.special_sword_right_arm_tz": "if(varb.attack,0,varb.agressive,0,if(varb.chestplate,2.5,2.25))",
