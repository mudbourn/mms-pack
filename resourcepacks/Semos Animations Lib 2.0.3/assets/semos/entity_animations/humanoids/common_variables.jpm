{
	"credit":"By Seb_Semos",
	"animations":[
		{	
			"var.scared":"clamp(if(limb_speed>0.9,min(20,var.scared+0.1*frame_time*20),max(0,var.scared-0.1*frame_time*20)),0,1)",
			"var.aggro":"if(is_aggressive,max((random(id)*10)/2,2),max(0,var.aggro-0.1*frame_time*20))",
			"varb.aggro":"var.aggro>0.01",
			"varb.agressive":"varb.aggro||varb.is_doing_magic",
			"varb.attack":"varb.aggro&&swing_progress!=0",
			"varb.helmet":"nbt(Inventory,raw:iregex:.*helmet.*)||nbt(Items,raw:iregex:.*helmet.*)||nbt(ArmorItems,raw:iregex:.*helmet.*)",
			"varb.chestplate":"nbt(Inventory,raw:iregex:.*chestplate.*)||nbt(Items,raw:iregex:.*chestplate.*)||nbt(ArmorItems,raw:iregex:.*chestplate.*)",
			"varb.leggings":"nbt(Inventory,raw:iregex:.*leggings.*)||nbt(Items,raw:iregex:.*leggings.*)||nbt(ArmorItems,raw:iregex:.*leggings.*)",
			"varb.boots":"nbt(Inventory,raw:iregex:.*boots.*)||nbt(Items,raw:iregex:.*boots.*)||nbt(ArmorItems,raw:iregex:.*boots.*)",
			"varb.in_water":"!is_riding&&!is_on_ground&&is_in_water",
			"varb.open_door_right_hand":"swing_progress!=0&&is_right_handed",
			"varb.open_door_left_hand":"swing_progress!=0&&!is_right_handed",
			"varb.sleeping":"nbt(SleepingX,raw:iregex:.*)||nbt(sleeping_pos,raw:iregex:.*)",
			"var.swim":"limb_swing/2+age/4",
			"var.pose":"if(is_riding||is_in_water&&!is_on_ground,0,clamp(1-limb_speed*4,0,1))*clamp(random(id)+0.3,0.3,1)",
			"var.ylook":"clamp(sin(var.r+age/60)*6,0,1)*1.2",
			"var.nope":"clamp(-239+cos(var.r+age/411)*240,0,1)/2*clamp(1-limb_speed*4,0,1)+if(head.rz!=0,1,0)",
			"var.blink":"sin((10*sin(0.5*(random(id)+age/30)-1)))+sin(5*(random(id)+age/30)-1)",
			"var.blink2":"sin(2*sin((age/75)+3))",
			"varb.blinking":"var.blink>0.7&&var.blink2>0.5",
			"var.nov1":"clamp(-5.6+cos(-pi/6+var.r+age/80)*6,0,1)*clamp(2-limb_speed*4,0,1)",
			"var.nov2":"clamp(-39+cos(-pi/4+var.r+var.b/20)*40,0,1)*clamp(1-limb_speed*2,0,1)",
			"var.nov3":"0",
			"var.r":"(pi*random(id)*4)+(limb_swing/20)*0",
			"var.b":"age/(11-random(id)*2)*if(is_child,1.5,1)",
			"var.ls":"limb_swing/if(limb_speed>0.75,1.4+(0.2*random(id)),1.1+(0.2*random(id)))",
			"var.run":"if(is_child,clamp(-1.5+limb_speed*4,0,1),clamp(-4+limb_speed*5,0,1))",
			"var.jump":"if(is_child&&!is_on_ground&&!is_in_water&&limb_speed==0,1,0)",
			"var.fall":"if(!is_riding&&!is_on_ground&&!is_in_water&&!is_child&&limb_speed==0,1,0)"
		}
	]
}